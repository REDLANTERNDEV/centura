# ============================================
# Centura CRM - Environment Configuration
# Geliştirme ve Üretim Ortamı
# ============================================

# ============================================
# Ortam Ayarları
# ============================================
NODE_ENV=development
# Üretim için: production

# ============================================
# Backend Konfigürasyonu
# ============================================
BACKEND_PORT=8765
PORT=8765

# Frontend URL'si (CORS için)
# Geliştirme: http://localhost:4321
# Üretim: https://centura.example.com
FRONTEND_URL=http://localhost:4321

# CORS Origins - Virgülle ayrılmış, BOŞLUKSUZ!
# Geliştirme: http://localhost:4321
# Üretim: https://centura.example.com
CORS_ORIGIN=http://localhost:4321

# ============================================
# Veritabanı Konfigürasyonu
# ============================================
DB_HOST=localhost
DB_PORT=5432
DB_NAME=centura_crm
DB_USER=postgres
DB_PASSWORD=your_secure_database_password_here

# ============================================
# JWT Konfigürasyonu
# ============================================
JWT_SECRET=your-super-secure-jwt-secret-key-here-at-least-32-characters-long
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ============================================
# Oturum Konfigürasyonu (CSRF Koruması)
# ============================================
SESSION_SECRET=your-session-secret-key-here-different-from-jwt-32-chars-minimum

# ============================================
# Cookie Konfigürasyonu
# ============================================
# Geliştirme: boş bırak (undefined)
# Üretim (tek subdomain): centura.example.com
# Üretim (birden fazla subdomain): .example.com
COOKIE_DOMAIN=.example.com
COOKIE_SECURE=true
COOKIE_HTTP_ONLY=true
COOKIE_SAME_SITE=Lax

# ============================================
# Frontend Konfigürasyonu
# ============================================
FRONTEND_PORT=4321

# Browser'dan API'ye erişim (browser-side requests)
NEXT_PUBLIC_API_URL=http://localhost:8765/api/v1
# Üretim için: https://centuraapi.example.com/api/v1

# Server-side istekleri için (Next.js SSR) - Docker'da backend container'ı kullan
# Geliştirme: kullanılmıyor (localhost için Next.js SSR devre dışı)
# Docker: http://backend:8765/api/v1
INTERNAL_API_URL=

# ============================================
# Analytics (Opsiyonel)
# ============================================
# Boş bırakılırsa hiçbir izleme scripti sayfaya eklenmez (varsayılan).
# NEXT_PUBLIC_* değerleri build sırasında bundle'a gömülür — değiştirdikten
# sonra frontend'i yeniden build edin.

# Sağlayıcı: umami | plausible | google | matomo | fathom | custom (boş = kapalı)
NEXT_PUBLIC_ANALYTICS_PROVIDER=

# Site kimliği — anlamı sağlayıcıya göre değişir:
#   umami     → website ID (UUID)
#   plausible → Plausible'da tanımlı alan adı, ör. example.com
#   google    → GA4 measurement ID, ör. G-XXXXXXXXXX
#   matomo    → sayısal site ID
#   fathom    → site ID
#   custom    → kullanılmaz (NEXT_PUBLIC_ANALYTICS_ATTRS kullanın)
NEXT_PUBLIC_ANALYTICS_SITE_ID=

# Self-hosted kurulumun adresi (sonunda / olmadan). Script yolu otomatik eklenir.
#   umami/plausible/matomo → zorunlu, ör. https://umami.example.com
#   google/fathom          → boş bırakın (bulut servisi)
NEXT_PUBLIC_ANALYTICS_HOST=

# Tam script URL'i — HOST'tan türetilen adresi geçersiz kılar.
# custom sağlayıcısı için zorunludur.
NEXT_PUBLIC_ANALYTICS_SRC=

# Script etiketine eklenecek fazladan öznitelikler (JSON).
# Ör. custom sağlayıcı için: {"data-website-id":"abc123"}
NEXT_PUBLIC_ANALYTICS_ATTRS=

# ============================================
# Docker Konfigürasyonu (Opsiyonel)
# ============================================
COMPOSE_PROJECT_NAME=centura
DOCKER_BUILDKIT=1

# ============================================
# Güvenlik Ayarları (İleri Düzey)
# ============================================
# Rate limiting (requests per minute)
RATE_LIMIT_WINDOW=15
RATE_LIMIT_MAX_REQUESTS=100

# ============================================
# Loglama
# ============================================
LOG_LEVEL=debug
# Üretim için: info

# ============================================
# Dosya Notları
# ============================================
# - Manuel kurulum: NODE_ENV=development, DB_HOST=localhost
# - Docker kurulum: NODE_ENV=production, DB_HOST=postgres
# - Güvenlik: JWT_SECRET ve SESSION_SECRET'i güçlü tutun (32+ karakter)
# - Frontend Port: Varsayılan 4321 (Next.js dev server)
# - Backend Port: Varsayılan 8765
